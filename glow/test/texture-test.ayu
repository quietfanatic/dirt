[ayu::Document {
    image: [glow::UniqueImage {
        size: [7 5]
        pixels: [
            $p = 0x2674dbf0
            $p $p $p $p $p $p $p
            $p $p $p $p $p $p $p
            $p $p $p $p $p $p $p
            $p $p $p $p $p $p $p
            $p $p $p $p $p $p $p
        ]
    }]
    texture: [glow::ImageTexture {
        image: #image
        filter: GL_LINEAR
    }]
    texture2: [glow::ImageTexture {
        image: image.qoi
    }]
}]
